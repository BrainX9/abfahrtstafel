# Zugangsdaten aus dem DB API Marketplace (Abo "OpenBoards")
DB_CLIENT_ID=
DB_API_KEY=

# Haltestelle(n) als EVA-Nummern, kommagetrennt (max. 15). 8000105 = Frankfurt (Main) Hbf
EVA_NUMBERS=8000105

# Überschrift der Tafel; leer = Name aus der API
STATION_TITLE=

# Optional, kommagetrennt: HIGH_SPEED_TRAIN,INTERCITY_TRAIN,INTER_REGIONAL_TRAIN,REGIONAL_TRAIN,CITY_TRAIN
TRANSPORT_TYPES=

# Zeitfenster in Minuten ab jetzt (max. 480)
WINDOW_MINUTES=60

# Anzahl Zeilen auf der Tafel
MAX_ROWS=15

# Abstand der API-Abrufe und der Aktualisierung im Browser (Sekunden, min. 10)
REFRESH_SECONDS=30

TZ=Europe/Berlin
